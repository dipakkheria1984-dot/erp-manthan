# Copy this file to backup.env (same folder) and fill it in.

# Your ERP Manthan address — the one you log in at.
ERP_URL=https://your-erp.vercel.app

# Must be exactly the same as JOB_SECRET in the ERP's environment variables.
# This secret can download the entire database. Treat it like the database
# password: do not email it, and change it if this PC is ever replaced.
ERP_JOB_SECRET=

# Where the archives are kept. A plain name is taken as a folder beside this
# script; an absolute path is used as given. Put it somewhere that is itself
# backed up — an external drive, or a OneDrive/Google Drive folder — so losing
# this PC does not also lose the backups.
BACKUP_DIR=archives

# How many months of backups to keep. Older ones are deleted after a new one
# has been downloaded and verified.
RETAIN_MONTHS=12

# Also download the student documents and photographs, not just the database.
# Off by default: the database archive is small and quick, while the documents
# can run to gigabytes. Turn it on once you have confirmed there is room.
WITH_FILES=false

# How many documents to download at once when WITH_FILES is on.
FILE_CONCURRENCY=4
