# --- Database -------------------------------------------------------------
# PostgreSQL connection string. Locally, create the database first:
#   createdb -U postgres erp_manthan
# On Vercel, use the *pooled* Neon connection string (the host containing
# `-pooler`). Serverless functions open a connection per invocation and an
# unpooled host runs out of them under any real load.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/erp_manthan?schema=public"

# --- Auth -----------------------------------------------------------------
# 32+ char random string used to sign session cookies.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
SESSION_TTL_HOURS="12"

# --- File uploads ---------------------------------------------------------
# Student documents, photos and the institute logo. src/lib/storage.ts picks
# its driver from BLOB_READ_WRITE_TOKEN below:
#
#   token unset -> local disk under UPLOAD_DIR (development)
#   token set   -> Vercel Blob             (production)
#
# On local disk everything is referenced by a path relative to UPLOAD_DIR, so
# moving the app to another machine only means copying that directory across.
UPLOAD_DIR="./storage/uploads"
MAX_UPLOAD_MB="5"

# Set automatically by Vercel when a Blob store is connected to the project —
# leave it out locally to keep using the disk. Blobs are written with private
# access, so documents stay reachable only through /api/documents/[id], which
# checks permissions first.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# --- Background jobs ------------------------------------------------------
# Shared secret required by POST /api/jobs/*. Send as `x-job-secret` header.
JOB_SECRET="change-me-job-secret"

# Vercel Cron cannot send a custom header, so scheduled runs authenticate with
# `Authorization: Bearer $CRON_SECRET` against GET /api/jobs/reminders instead.
# Only needed on Vercel; the schedule is in vercel.json.
# CRON_SECRET="change-me-cron-secret"

# --- Seed -----------------------------------------------------------------
# Initial Admin account created by `npm run db:seed`. The first sign-in forces
# a password change, but set a real password anyway before seeding anything
# reachable from the internet — the values below are published in this
# repository, and the seed refuses to run with the default under NODE_ENV=production.
SEED_ADMIN_EMAIL="admin@institute.test"
SEED_ADMIN_PASSWORD="Admin@12345"

# The institute operates in IST. Date arithmetic (due dates, days overdue)
# follows the process time zone, so the app must run as IST wherever it is
# hosted. Displayed dates are pinned to Asia/Kolkata regardless.
TZ="Asia/Kolkata"
