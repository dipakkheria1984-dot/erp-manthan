# Copy this file to bridge.env (same folder) and fill it in.

# Your ERP Manthan address — the one you log in at.
ERP_URL=https://your-erp.vercel.app

# Must be exactly the same as TALLY_BRIDGE_KEY in the ERP's environment variables.
ERP_BRIDGE_KEY=

# TallyPrime's XML port. Change only if you set a different port in
# F1 Help > Settings > Connectivity > Client/Server configuration.
TALLY_URL=http://localhost:9000

# How often to check for new receipts, in seconds.
POLL_SECONDS=20
